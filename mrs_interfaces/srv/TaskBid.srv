# Request
int32 bidder_id     # robot id (starting at 1)
int32 task_id
int32 es    # earliest start time for task

---
# Response 
bool all_received   # returns true if all requests have been received
int32[] neighbours  # for MR tasks
bool assigned  # true if the requesting bidder is assigned this task
int32[] precedence_tasks  # precendence constraints
 